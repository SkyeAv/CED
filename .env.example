CED_REMOTE_HOST=wenceslaus
CED_REMOTE_PROJECT=/local_raid1/sgoetz/Code/ISB/CED
CED_ARTIFACT_ROOT=.ced
CED_FULLMAP=/home/sgoetz/Desktop/fullmap
CED_CPU_WORKERS=4
CED_MEMORY_LIMIT=16GB
CED_DISK_RESERVE_GB=32
# Connections per file: aria2 -x and the segmented http backend's maximum segment count.
CED_DOWNLOAD_CONNECTIONS=8
# Sources fetched concurrently by `ced fetch` (1-4).
CED_DOWNLOAD_JOBS=4
PYTHONUTF8=1
# Set Modal credentials only in the untracked wenceslaus .env or environment.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
